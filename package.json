{
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "http-status-codes": "^2.3.0"
  },
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test tests/api",
    "test:ui": "playwright test tests/ui",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "test:docker": "npm run db:start && npm run db:migrate && DATABASE_URL='postgresql://testuser:testpassword@localhost:5433/app_test?schema=public' playwright test",
    "test:docker:reset": "npm run db:reset && npm run test:docker",
    "db:start": "bash scripts/test-db.sh start",
    "db:stop": "bash scripts/test-db.sh stop",
    "db:reset": "bash scripts/test-db.sh reset",
    "db:status": "bash scripts/test-db.sh status",
    "db:migrate": "DATABASE_URL='postgresql://testuser:testpassword@localhost:5433/app_test?schema=public' bash scripts/run-migrations.sh",
    "build": "npm run typecheck",
    "typecheck": "tsc",
    "lint": "biome lint tests playwright.config.ts",
    "format": "biome format --write tests playwright.config.ts",
    "format:check": "biome format tests playwright.config.ts"
  }
}